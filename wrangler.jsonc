{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "therothacademy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roth-academy-applications",
      "database_id": "83d4325d-1448-4764-b4ed-0f065223263b",
      "migrations_dir": "migrations"
    }
  ],
  // SSN_ENCRYPTION_KEY, ABANDONED_CHECK_SECRET, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, and DISCOUNT_ADMIN_SECRET are intentionally NOT
  // declared here. Any key listed
  // under `vars` is reasserted on every deploy -- if a secret of the same
  // name was set via `wrangler secret put` or the dashboard, that deploy
  // silently overwrites it back to the literal value in this file (an empty
  // string, if that's what's here), wiping the real secret. These four must
  // only ever be set as actual Cloudflare secrets, never as `vars`. Locally,
  // set them in a gitignored .dev.vars file instead (wrangler reads it
  // automatically; .env.local is not used for Cloudflare bindings by the
  // installed @opennextjs/cloudflare version).
  "vars": {}
}
